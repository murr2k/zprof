# west workspace (pulled by `west update`, never committed). Root-anchored so
# our own module's zephyr/ directory is not ignored.
/.west/
/zephyr/
/modules/
/bootloader/
/tools/

# Builds
build/
build-*/

# Python
.venv/
__pycache__/
*.py[cod]

# Web
web/node_modules/
web/dist/

# Recordings from the bridge can be large, and name the user's threads and
# hosts; captures/ is where they go by default
*.zprec
*.zpr
captures/
.pytest_cache/

# Editor / OS
.vscode/
.idea/
.DS_Store
